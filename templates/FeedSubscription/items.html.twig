{% extends 'layout.html.twig' %}

{% block title %}{{ feed.title }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col s12">
            {% if is_granted('ROLE_USER') %}
                <a class="waves-effect btn-flat feed-action" href="{{ path('all_import_feed') }}">{{ 'feeds.action.back_to_list'|trans }}</a>
            {% endif %}
            {% if items is empty %}
                <p>{{ 'feeds.items_empty'|trans }}</p>
            {% else %}
                <ol class="entries row entries-row">
                    {% for item in items %}
                        <li class="s12">
                            <article class="card entry-card">
                                <div class="card-body">
                                    {% if item.image and app.user.config.displayThumbnails %}
                                        <div class="card-image">
                                            <a class="feed-preview" href="{{ item.url }}" rel="noreferrer" tabindex="-1" aria-hidden="true">
                                                <img class="responsive-img" src="{{ item.image }}" alt="" loading="lazy" referrerpolicy="no-referrer">
                                            </a>
                                        </div>
                                    {% endif %}
                                    <div class="card-content">
                                        <a class="card-title feed-url" href="{{ item.url }}" rel="noreferrer">{{ item.title ?: item.url }}</a>
                                        {% if item.publishedAt %}
                                            <time class="grey-text" datetime="{{ item.publishedAt|date('c') }}">{{ item.publishedAt|date('Y-m-d') }}</time>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="card-action">
                                    {% if is_granted('SAVE', item) %}
                                        <form class="inline-block" action="{{ path('save_item', {id: item.id}) }}" method="post">
                                            <input type="hidden" name="token" value="{{ csrf_token('feed-save-item-' ~ item.id) }}">
                                            <button class="waves-effect btn-flat feed-action" type="submit">
                                                <i class="material-icons left" aria-hidden="true">save</i>{{ 'feeds.action.save_article'|trans }}
                                            </button>
                                        </form>
                                    {% endif %}
                                    {% if is_granted('DISMISS', item) %}
                                        <form class="inline-block" action="{{ path('delete_item', {id: item.id}) }}" method="post">
                                            <input type="hidden" name="token" value="{{ csrf_token('feed-delete-item-' ~ item.id) }}">
                                            <button class="waves-effect btn-flat feed-action" type="submit">
                                                <i class="material-icons left" aria-hidden="true">close</i>{{ 'feeds.action.dismiss'|trans }}
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </article>
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}
        </div>
    </div>
{% endblock %}
