{% extends 'layout.html.twig' %}

{% block title %}{{ 'feeds.page_title'|trans }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col s12">
            {% if is_granted('ROLE_USER') %}
                <p>
                    <a class="btn waves-effect waves-light" href="{{ path('new_feed') }}">
                        <i class="material-icons left" aria-hidden="true">add</i>{{ 'feeds.action.add'|trans }}
                    </a>
                </p>
            {% endif %}

            {% for feed in feeds %}
                <article class="card">
                    <div class="card-content">
                        <h2 class="card-title feed-subscription-title">{{ feed.title }}</h2>
                        <span class="grey-text">{{ (feed.automatic ? 'feeds.automatic_mode' : 'feeds.manual_mode')|trans }}</span>
                        <p><a href="{{ feed.url }}" rel="noreferrer" class="feed-url">{{ feed.url }}</a></p>
                        {% if feed.updatedAt %}
                            <p>{{ 'feeds.last_fetch'|trans({'%date%': feed.updatedAt|date('Y-m-d H:i')}) }}</p>
                        {% endif %}
                        {% if not feed.updatedAt or feed.updatedAt < date('-2 days') %}
                            <p>{{ 'feeds.stale'|trans }}</p>
                        {% endif %}
                    </div>
                    {% set has_article_actions = not feed.automatic or pendingFeeds[feed.id] is defined %}
                    <div class="card-action">
                        {% if has_article_actions and is_granted('LIST_ITEMS', feed) %}
                            <a class="waves-effect btn-flat feed-action" href="{{ path('display_feed_items', {id: feed.id}) }}">
                                <i class="material-icons left" aria-hidden="true">list</i>{{ 'feeds.action.items'|trans }}
                            </a>
                        {% endif %}
                        {% if is_granted('EDIT', feed) %}
                            <a class="waves-effect btn-flat feed-action" href="{{ path('edit_feed', {id: feed.id}) }}">
                                <i class="material-icons left" aria-hidden="true">edit</i>{{ 'feeds.action.edit'|trans }}
                            </a>
                        {% endif %}
                        {% if is_granted('REFRESH', feed) %}
                            <form class="inline-block" action="{{ path('fetch_feed', {id: feed.id}) }}" method="post">
                                <input type="hidden" name="token" value="{{ csrf_token('feed-fetch-' ~ feed.id) }}">
                                <button class="waves-effect btn-flat feed-action" type="submit">
                                    <i class="material-icons left" aria-hidden="true">refresh</i>{{ 'feeds.action.fetch'|trans }}
                                </button>
                            </form>
                        {% endif %}
                        {% if has_article_actions and is_granted('PURGE_ITEMS', feed) %}
                            <form class="inline-block" action="{{ path('purge_feed', {id: feed.id}) }}" method="post" onsubmit="return confirm('{{ 'feeds.alert.confirm_purge'|trans|escape('js') }}')">
                                <input type="hidden" name="token" value="{{ csrf_token('feed-purge-' ~ feed.id) }}">
                                <button class="waves-effect btn-flat feed-action" type="submit">
                                    <i class="material-icons left" aria-hidden="true">delete_sweep</i>{{ 'feeds.action.purge'|trans }}
                                </button>
                            </form>
                        {% endif %}
                        {% if is_granted('DELETE', feed) %}
                            <form class="inline-block" action="{{ path('delete_feed', {id: feed.id}) }}" method="post" onsubmit="return confirm('{{ 'feeds.alert.confirm_delete'|trans|escape('js') }}')">
                                <input type="hidden" name="token" value="{{ csrf_token('feed-delete-' ~ feed.id) }}">
                                <button class="waves-effect btn-flat feed-action" type="submit">
                                    <i class="material-icons left" aria-hidden="true">delete</i>{{ 'feeds.action.delete'|trans }}
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </article>
            {% else %}
                <p>{{ 'feeds.empty'|trans }}</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
