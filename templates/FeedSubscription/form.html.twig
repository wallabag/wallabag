{% extends 'layout.html.twig' %}

{% block title %}{{ title|trans }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col s12">
            {% if form.vars.data.id ? is_granted('EDIT', form.vars.data) : is_granted('ROLE_USER') %}
                <div class="card-panel">
                    {{ form_start(form) }}
                        {{ form_errors(form) }}
                        <div class="row">
                            <div class="input-field col s12">
                                {{ form_label(form.title) }}
                                {{ form_errors(form.title) }}
                                {{ form_widget(form.title) }}
                            </div>
                            <div class="input-field col s12">
                                {{ form_label(form.url) }}
                                {{ form_errors(form.url) }}
                                {{ form_widget(form.url) }}
                            </div>
                        </div>
                        {{ form_widget(form.save, {attr: {class: 'btn waves-effect waves-light'}}) }}
                        <a class="waves-effect btn-flat feed-action" href="{{ path('all_import_feed') }}">{{ 'feeds.action.back_to_list'|trans }}</a>
                    {{ form_end(form) }}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
