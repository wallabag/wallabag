{% extends "base.html.twig" %}

{% set current_route = app.request.attributes.get('_route') %}
{% set current_route_from_query_params = app.request.query.get('currentRoute') %}

{% block css %}
    {{ parent() }}

    {{ encore_entry_link_tags('main') }}
{% endblock %}

{% block scripts %}
    {{ parent() }}

    {{ encore_entry_script_tags('main') }}
{% endblock %}

{% block header %}
{% endblock %}

{% block messages %}
    {% set available_update = wallabag_available_update() %}
    {% if available_update and available_update.security %}
        <div class="card-panel red darken-1 white-text">
            {{ 'update.security_banner'|trans({'%version%': available_update.version}) }}
            <a class="white-text" href="{{ available_update.url }}"><strong>{{ 'update.read_more'|trans }}</strong></a>
        </div>
    {% endif %}
    {% for flash_message in app.session.flashbag.get('notice') %}
        <p class="hidden" data-controller="materialize--toast">{{ flash_message|trans }}</p>
    {% endfor %}
{% endblock %}

{% block body_class %}index wb-app{% endblock %}

{% block menu %}
    <div class="wb-chrome" data-controller="drawer topbar">
        <aside class="wb-sidebar" id="wb-sidebar" aria-label="wallabag">
            {% block logo %}
                <a class="wb-brand" title="{{ 'menu.left.back_to_homepage'|trans }}" href="{{ is_granted('LIST_ENTRIES') ? path('homepage') : '#' }}">
                    <img src="{{ asset('img/logo-square.svg') }}" alt="" width="36" height="36">
                    <span>wallabag</span>
                </a>
            {% endblock %}

            {% if is_granted('CREATE_ENTRIES') or is_granted('LIST_ENTRIES') %}
                <div class="wb-sidebar-actions">
                    {% if is_granted('CREATE_ENTRIES') %}
                        <twig:ui:Button variant="primary" :block="true" :href="path('new')" data-action="drawer#close topbar#showAddUrl:prevent:stop">
                            {{ icon('plus', 18) }}<span>{{ 'menu.top.add_new_entry'|trans }}</span>
                        </twig:ui:Button>
                    {% endif %}
                    {% if is_granted('LIST_ENTRIES') %}
                        <button type="button" class="wb-nav-link" data-action="drawer#close topbar#showSearch:stop">
                            {{ icon('search') }}<span class="wb-nav-label">{{ 'menu.top.search'|trans }}</span><kbd class="wb-kbd">s</kbd>
                        </button>
                    {% endif %}
                </div>
            {% endif %}

            {{ knp_menu_render('wallabag_main', {
                template: 'Menu/app_nav.html.twig',
            }) }}

            {{ knp_menu_render('wallabag_account', {
                template: 'Menu/account.html.twig',
            }) }}
        </aside>

        <header class="wb-topbar">
            <twig:ui:IconButton icon="menu" :size="22" label="menu" class="wb-menu-toggle" aria-controls="wb-sidebar" aria-expanded="false" data-action="drawer#toggle" data-drawer-target="toggle" />
            <h1 class="wb-page-title">{% block title %}{% endblock %}</h1>
            <ul class="wb-toolbar">
                {% if is_granted('LIST_ENTRIES') %}
                    <li>
                        <twig:ui:IconButton icon="search" :label="'menu.top.search'|trans" data-action="topbar#showSearch:stop" data-shortcuts-target="showSearch" />
                    </li>
                {% endif %}
                {% block nav_panel_extra_actions '' %}
                {% if is_granted('CREATE_ENTRIES') %}
                    <li class="wb-toolbar-add">
                        <twig:ui:Button variant="primary" :href="path('new')" :title="'menu.top.add_new_entry'|trans" :aria-label="'menu.top.add_new_entry'|trans" data-action="topbar#showAddUrl:prevent:stop" data-shortcuts-target="showAddUrl">{{ icon('plus', 18) }}</twig:ui:Button>
                    </li>
                {% endif %}
            </ul>
            {% if is_granted('LIST_ENTRIES') %}
                {{ render(controller('Wallabag\\Controller\\EntryController::searchFormAction', {'currentRoute': current_route})) }}
            {% endif %}
            {% if is_granted('CREATE_ENTRIES') %}
                {{ render(controller('Wallabag\\Controller\\EntryController::addEntryFormAction')) }}
            {% endif %}
        </header>
    </div>
{% endblock %}

{% block footer %}
    <footer class="wb-footer">
        <p>{{ display_stats() }}</p>
        <p>
            {{ 'footer.wallabag.powered_by'|trans }} <a target="_blank" rel="noopener" href="https://wallabag.org">wallabag</a> ·
            <a href="{{ path('about') }}">{{ 'footer.wallabag.about'|trans|lower }}</a>
        </p>
    </footer>
{% endblock %}
