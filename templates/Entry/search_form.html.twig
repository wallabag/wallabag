<twig:ui:Dialog data-topbar-target="search" data-action="click->topbar#closeOnBackdrop">
    <form name="search" method="GET" action="{{ path('search') }}">
        {% if form_errors(form) %}
            <span class="wb-form-error">{{ form_errors(form) }}</span>
        {% endif %}

        <input type="hidden" name="currentRoute" value="{{ currentRoute }}" />

        {{ icon('search') }}
        {{ form_widget(form.term, {'attr': {'autocomplete': 'off', 'placeholder': 'entry.search.placeholder', 'data-topbar-target': 'searchInput'}}) }}
        <twig:ui:Button variant="primary" type="submit">{{ 'menu.top.search'|trans }}</twig:ui:Button>
        <twig:ui:IconButton icon="close" label="close" data-action="topbar#showActions" data-shortcuts-target="showActions" />

        {% if form_errors(form.term) %}
            <span class="wb-form-error">{{ form_errors(form.term) }}</span>
        {% endif %}

        {{ form_rest(form) }}
    </form>
</twig:ui:Dialog>
