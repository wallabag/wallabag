<twig:ui:Dialog data-topbar-target="addUrl" data-action="click->topbar#closeOnBackdrop">
    <form name="entry" method="post" action="{{ path('new_entry') }}" data-action="topbar#submittingUrl">
        {% if form_errors(form) %}
            <span class="wb-form-error">{{ form_errors(form) }}</span>
        {% endif %}

        {{ icon('link') }}
        {{ form_widget(form.url, {'attr': {'autocomplete': 'off', 'placeholder': 'entry.new.placeholder', 'data-topbar-target': 'addUrlInput'}}) }}
        <twig:ui:Button variant="primary" type="submit">{{ 'menu.top.add_new_entry'|trans }}</twig:ui:Button>
        <twig:ui:IconButton icon="close" label="close" data-action="topbar#showActions" data-shortcuts-target="showActions" />

        {% if form_errors(form.url) %}
            <span class="wb-form-error">{{ form_errors(form.url) }}</span>
        {% endif %}

        {{ form_rest(form) }}
    </form>
</twig:ui:Dialog>
