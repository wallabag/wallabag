<?xml version="1.0" encoding="utf-8"?>
<OpenSearchDescription xmlns="http://a9.com/-/spec/opensearch/1.1/" xmlns:moz="http://www.mozilla.org/2006/browser/search/">
    <ShortName>wallabag</ShortName>
    <Description>Search your articles saved in wallabag</Description>
    <InputEncoding>UTF-8</InputEncoding>
    <Image width="16" height="16" type="image/x-icon">{{ asset('favicon.ico') }}</Image>
    <Url type="text/html" method="get" template="{{ url('search') }}?search_entry%5Bterm%5D={searchTerms}"/>
    <Url type="application/opensearchdescription+xml" rel="self" template="{{ url('opensearch') }}"/>
    <moz:SearchForm>{{ url('search') }}</moz:SearchForm>
</OpenSearchDescription>
